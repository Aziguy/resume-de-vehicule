{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "brakson/resume-vehicule",
	"version": "1.2.0",
	"title": "Résumé de véhicule",
	"category": "brakson-category",
	"icon": "car",
	"description": "Affiche les caractéristiques techniques d'un véhicule issues d'une source de données externe.",
	"keywords": [ "véhicule", "voiture", "fiche technique", "caractéristiques", "auto" ],
