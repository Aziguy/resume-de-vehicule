				"model": "Clio",
				"energy": "Essence",
				"maxSpeed": 180,
				"power": 90,
				"dimensions": { "length": 4050, "width": 1798, "height": 1440 },
				"price": { "base": 19500, "current": 18900 },
				"commercialized": true,
				"updatedAt": "2024-04-01T00:00:00+00:00"
			}
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
