{
	"name": "resume-vehicule-block",
	"version": "1.1.0",
	"description": "Affiche les caractéristiques techniques d'un véhicule depuis l'éditeur Gutenberg en se basant sur une base de données externe.",
	"keywords": [
		"véhicule",
		"caractéristiques techniques",
		"éditeur Gutenberg",
		"journalistes",
		"base de données externe",
		"contenus WordPress",
		"bloc Gutenberg",
		"WordPress",
		"plugin",
		"extension"
	],
	"author": "Hippolyte KENGNI",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/Aziguy/resume-de-vehicule#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Aziguy/resume-de-vehicule.git"
	},
	"bugs": {
		"url": "https://github.com/Aziguy/resume-de-vehicule/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"main": "build/index.js",
	"files": [
		"build",
		"includes",
		"resume-vehicule-block.php",
		"uninstall.php",
		"readme.txt",
		"LICENSE"
	],
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"lint:js": "wp-scripts lint-js src tests/js",
		"test": "wp-scripts test-unit-jest",
		"test:coverage": "wp-scripts test-unit-jest --coverage",
		"test:php": "composer test",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@wordpress/babel-preset-default": "^10.0.0",
		"@wordpress/jest-preset-default": "^14.2.0",
		"@wordpress/scripts": "^37.0.0",
		"autoprefixer": "^10.6.1",
		"globals": "^16.5.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"postcss": "^8.4.38",
		"tailwindcss": "^3.4.3"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/element": "^5.35.0",
		"@wordpress/i18n": "^4.58.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/url": "^3.59.0",
		"react-icons": "^5.7.0"
	}
}
